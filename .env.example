# LUMEN LEARN — environment example.
# The demo runs with NO environment variables: every integration below is simulated.
# These names document the planned production configuration only.

# Public URL of the deployment (used for absolute links in emails / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Planned: database (PostgreSQL with tenant-scoped rows + row-level security) ---
# DATABASE_URL=postgresql://lumen:password@localhost:5432/lumen
# DATABASE_POOL_URL=

# --- Planned: auth (sessions, MFA for staff/admin, guardian-linked child accounts) ---
# AUTH_SECRET=
# AUTH_URL=

# --- Planned: file storage (private buckets, signed URLs, virus scanning) ---
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# --- Planned: payments (NGN). NOT CONNECTED IN THE DEMO. ---
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_KEY=

# --- Planned: video classes. NOT CONNECTED IN THE DEMO. ---
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=

# --- Planned: notifications (email / SMS / WhatsApp Business via a queue worker) ---
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
# QUEUE_URL=
